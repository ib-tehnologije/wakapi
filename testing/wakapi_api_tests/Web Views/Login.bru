meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/login
  body: formUrlEncoded
  auth: none
}

script:pre-request {
  req.setMaxRedirects(0)
}

body:form-urlencoded {
  username: writeuser
  password: {{WRITEUSER_PASSWORD}}
}

script:post-response {
  const authCookie = res.headers['set-cookie'].find(cookie => cookie.startsWith('wakapi_auth='))
  if (!authCookie) throw new Error('login did not set an authentication cookie')
  bru.setVar('WEB_AUTH_COOKIE', authCookie.split(';')[0])
}

assert {
  res.status: eq 302
  res.headers['location']: eq /summary
}
