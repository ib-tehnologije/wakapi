meta {
  name: Settings
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/settings
  body: none
  auth: none
}

script:pre-request {
  bru.cookies.jar().clear()
}

headers {
  Cookie: {{WEB_AUTH_COOKIE}}
}

assert {
  res.body: contains </html>
  res.body: contains <span class="text-sm">Logout</span>
}
